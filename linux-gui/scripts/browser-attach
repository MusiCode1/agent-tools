#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$(realpath "$0")")/lib.sh"
load_env
name=${1:?Usage: browser-attach NAME}
validate_profile "$name"
require_container
port=$(profile_cdp_port "$name")
[[ -n "$port" ]] || die "Profile is not running in CDP mode: $name"
[[ "$port" =~ ^92[2-9][0-9]$ ]] || die "Invalid recorded CDP port"
gui_exec --workdir "/data/browser-projects/$name" \
  playwright-cli attach --cdp="http://127.0.0.1:$port"
