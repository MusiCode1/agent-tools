<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="root-menu" label="Linux GUI">
    <item label="Google Chrome (CDP)">
      <action name="Execute">
        <command>sh -lc '/usr/local/bin/linux-gui-browser-launch user cdp about:blank &gt;/tmp/user-chrome.log 2&gt;&amp;1'</command>
      </action>
    </item>
    <item label="Files">
      <action name="Execute">
        <command>xfe /data/downloads</command>
      </action>
    </item>
    <item label="Terminal">
      <action name="Execute">
        <command>xfce4-terminal</command>
      </action>
    </item>
    <menu id="apps-menu" label="Applications" execute="/usr/local/bin/linux-gui-apps-menu" />
    <separator />
    <item label="Refresh menu">
      <action name="Reconfigure" />
    </item>
  </menu>
</openbox_menu>
