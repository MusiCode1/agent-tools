#!/usr/bin/env bash
set -euo pipefail

profile_name=${1:?profile name is required}
if [[ ! "$profile_name" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "Invalid profile name" >&2
  exit 2
fi

profile_dir="/data/browser-profiles/$profile_name"
runtime_dir="/data/browser-projects/$profile_name/runtime"

if [[ -f "$runtime_dir/pid" ]]; then
  pid=$(<"$runtime_dir/pid")
  if [[ "$pid" =~ ^[0-9]+$ ]] && [[ -r "/proc/$pid/cmdline" ]] &&
      tr '\0' '\n' <"/proc/$pid/cmdline" | grep -Fxq -- "--user-data-dir=$profile_dir"; then
    kill -TERM "$pid"
    for _ in $(seq 1 30); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.2
    done
  fi
fi

# Recover stale metadata by matching an exact argv item, never a process-name
# pattern. The profile caller is responsible for owning the browser it closes.
python3 - "$profile_dir" <<'PY'
import os, pathlib, signal, sys
expected = ('--user-data-dir=' + sys.argv[1]).encode()
for process in pathlib.Path('/proc').glob('[0-9]*'):
    try:
        if expected in (process / 'cmdline').read_bytes().split(b'\0'):
            os.kill(int(process.name), signal.SIGTERM)
    except (ProcessLookupError, FileNotFoundError, PermissionError):
        pass
PY
rm -f \
  "$profile_dir/SingletonLock" \
  "$profile_dir/SingletonCookie" \
  "$profile_dir/SingletonSocket"
rm -f "$runtime_dir/pid" "$runtime_dir/mode" "$runtime_dir/cdp-port"
echo "Closed profile: $profile_name"
