#!/usr/bin/env python3
"""ask — חיפוש אחד בכל מאגרי הידע, עם בלוק הקשר סביב המילה.

מקורות: knowledge (~/.recoll) · sessions (agent-sessions DB) · comms (comms-index DB) · diary (~/.recoll-diary).
🛑 diary ו-comms לעולם אינם בברירת-מחדל — ראו agents-config .../rules/80-text-search.md.
"""
import argparse, html, json, os, re, sqlite3, sys, time

HOME = os.path.expanduser("~")
CONF_KNOW = os.path.join(HOME, ".recoll")
CONF_DIARY = os.path.join(HOME, ".recoll-diary")
CFG = os.path.join(HOME, ".config/agent-sessions/config.json")
DB_DEFAULT = os.path.join(HOME, ".local/state/agent-sessions/sessions.db")
CFG_COMMS = os.path.join(HOME, ".config/comms-index/config.json")
DB_COMMS_DEFAULT = os.path.join(HOME, ".local/state/comms-index/comms.db")
SOURCES = ("knowledge", "sessions", "comms", "diary")
PRIVATE = ("comms", "diary")         # 🔒 מפורש בלבד
HL_OPEN, HL_CLOSE = "«", "»"
SCAN_STEPS = (40, 200, 800)          # סריקה הדרגתית: rust דורש 400+, codeshark די לו ב-40
COMMS_SCAN_STEPS = (40, 200, 1000, 5000)
CHANNELS = {"wa": "wa", "whatsapp": "wa", "sms": "sms"}
HEB = "\u05d0-\u05ea"
WORDCH = "\\w\u0590-\u05ff"          # אות לצורך גבול-מילה, כולל ניקוד וטעמים
HEB_PREFIX = "[ובהלמשכ]{0,3}"        # ו/ה/ב/ל/מ/ש/כ נצמדות למילה, גם בצירופים (וכש, שב, מה)
FTS_OPS = {"AND", "OR", "NOT", "NEAR"}


class _Quiet:
    """recoll מדפיס ':3:../common/rclinit.cpp:420::Recoll 1.43…' ל-fd 2 ברמת C.
    הפניה של sys.stderr אינה מספיקה — צריך להחליף את תיאור-הקובץ עצמו."""
    def __enter__(self):
        self._saved = os.dup(2)
        self._null = os.open(os.devnull, os.O_WRONLY)
        os.dup2(self._null, 2)
        return self

    def __exit__(self, *a):
        os.dup2(self._saved, 2)
        os.close(self._null); os.close(self._saved)
        return False


def die(msg, code=2):
    print(f"ask: {msg}", file=sys.stderr)
    sys.exit(code)


def sessions_db():
    """נתיב ה-DB מהקונפיג ולא מנתיב קשיח — הסכמה שייכת לריפו אחר."""
    try:
        with open(CFG, encoding="utf-8") as f:
            p = json.load(f).get("db_path")
        if p:
            return os.path.expanduser(p)
    except FileNotFoundError:
        pass
    except Exception as e:
        die(f"קונפיג agent-sessions פגום ({CFG}): {e}")
    return DB_DEFAULT


def term_parts(term):
    """מונח → חלקים לסינון. ביטוי במרכאות הוא חלק אחד; כל מילה אחרת חלק משלה.

    🛑 תחביר FTS (מרכאות, סוגריים, AND/OR/NOT) אינו טקסט: גרסה קודמת חיפשה את תו
    המרכאה עצמו, ו-'"worktree prune"' השאיר 5 תוצאות מתוך 674.
    """
    parts = [p.split() for p in re.findall(r'"([^"]*)"', term) if p.split()]
    rest = re.sub(r'"[^"]*"', " ", term).replace('"', " ")
    parts += [[w] for w in (t.strip("()") for t in rest.split()) if w and w not in FTS_OPS]
    return parts


def part_re(words, whole_word=True):
    """חלק → regex. מילה שלמה, ולפני מילה עברית מותרות תחיליות.

    🔑 בעברית ו/ה/ב/ל/מ/ש/כ נצמדות למילה: "פגישה" צריך למצוא גם "בפגישה". גבול-מילה
    קשיח זרק אותן — נמדד: ‏29 מתוך 40 תוצאות על "פגישה" נעלמו. כוכבית בסוף = בלי
    גבול מימין. whole_word=False: רצף התווים בלבד, למרכוז הקטע.
    """
    star = words[-1].endswith("*")
    words = [w.strip("*") for w in words if w.strip("*")]
    if not words:
        return None
    body = r"\s+".join(re.escape(w) for w in words)
    if not whole_word:
        return re.compile(body, re.I)
    lead = HEB_PREFIX if re.match(f"[{HEB}]", words[0]) else ""
    tail = "" if star else f"(?![{WORDCH}])"
    return re.compile(f"(?<![{WORDCH}]){lead}{body}{tail}", re.I)


def word_filter(term, need_all):
    """פרדיקט מילה-שלמה. need_all: כל החלקים בטקסט (הודעה שלמה); אחרת די באחד —
    קטע מתוך שיחה ארוכה אינו מכיל בהכרח את כל המילים."""
    regs = [r for r in (part_re(p) for p in term_parts(term)) if r]
    if not regs:
        return None
    if not need_all or re.search(r"\b(OR|NOT)\b", term):
        return lambda text: any(r.search(text) for r in regs)
    return lambda text: all(r.search(text) for r in regs)


def window(text, regs, ctx):
    """קטע של ctx מילים מכל צד סביב ההתאמה הראשונה."""
    flat = " ".join(text.split())
    m = next((m for m in (r.search(flat) for r in regs) if m), None)
    if not m:
        words = flat.split()
        return " ".join(words[:ctx * 2]) + (" …" if len(words) > ctx * 2 else "")
    s, e = m.start(), m.end()
    for _ in range(ctx):
        k = flat.rfind(" ", 0, max(s - 1, 0))
        if k < 0:
            s = 0
            break
        s = k + 1
    for _ in range(ctx):
        k = flat.find(" ", e + 1)
        if k < 0:
            e = len(flat)
            break
        e = k
    return ("… " if s > 0 else "") + flat[s:e] + (" …" if e < len(flat) else "")


def clean(text):
    """🛑 להסיר את סימני ההדגשה לפני בדיקת מילה-שלמה.
    t«rust»cache נראה כמילה שלמה אם בודקים אחרי העטיפה — נמדד ונשבר כך פעם אחת."""
    return html.unescape(text.replace(HL_OPEN, "").replace(HL_CLOSE, ""))


def search_recoll(confdir, term, limit, ctx, label, stem=False):
    try:
        from recoll import recoll
    except ImportError:
        die("מודול recoll חסר — apt install python3-recoll")
    if not os.path.isdir(confdir):
        return {"source": label, "total": 0, "hits": [], "error": f"אין אינדקס ב-{confdir}"}
    with _Quiet():
        db = recoll.connect(confdir=confdir)
    q = db.query()
    # 🛑 stemming=0 — ברירת-המחדל של ה-API מרחיבה inotify ל-notify/notified/notifier
    # ומחזירה 1,892 במקום 52. recollq אינו עושה זאת, ו-80-text-search קובע
    # ש-recoll הוא צורה-מדויקת. --stem מחזיר את ההרחבה למי שרוצה אותה.
    total = q.execute(term, stemming=1 if stem else 0)
    # 🛑 איחוד תוך-כדי, לא אחרי: getsnippets עולה, ולכן כפילות נזרקת לפני
    # שמשלמים עליה. ותקרת-סריקה — אחרת תוצאה עם 200 כפילויות סורקת הכול.
    hits, seen, scanned = [], {}, 0
    cap = max(limit * 6, 40)
    for doc in q:
        scanned += 1
        url = (doc.get("url") or "").replace("file://", "")
        key = os.path.basename(url)
        if key in seen:
            seen[key]["dupes"] = seen[key].get("dupes", 0) + 1
            if scanned >= cap:
                break
            continue
        snips = [{"line": ln, "text": " ".join(html.unescape(txt).split())}
                 for ln, _t, txt in q.getsnippets(doc, maxoccs=2, ctxwords=ctx, nohl=True)]
        h = {"path": os.path.relpath(url, HOME) if url.startswith(HOME) else url,
             "title": doc.get("title") or "", "space": doc.get("space") or "",
             "lifecycle": doc.get("lifecycle") or "", "mtype": doc.get("mtype") or "",
             "snippets": snips[:2]}
        seen[key] = h
        hits.append(h)
        if len(hits) >= limit or scanned >= cap:
            break
    return {"source": label, "total": total, "hits": hits, "scanned": scanned}


def fts_query(term):
    """מונח → שאילתת FTS5. מילה עם מקף, נקודה, נתיב או נקודתיים נעטפת במרכאות.

    בלי זה `agents-kb-tools` נקרא כביטוי עם אופרטור ו-`gui-portal` כעמודה,
    וה-DB זורק `no such column`. מחרוזת שכבר מכילה מרכאות עוברת כמו שהיא —
    המשתמש בחר בה תחביר FTS במפורש.
    """
    if '"' in term:
        return term
    return " ".join(tok if re.fullmatch(r"\w+", tok) else '"' + tok + '"'
                    for tok in term.split())


def search_sessions(term, limit, ctx, filters, whole_word):
    db = sessions_db()
    if not os.path.exists(db):
        return {"source": "sessions", "total": 0, "hits": [], "error": f"אין DB ב-{db}"}
    con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
    where, params = ["messages_fts match ?"], [fts_query(term)]
    for col, key in (("m.role", "role"), ("s.cli", "cli")):
        if filters.get(key):
            where.append(f"{col} = ?"); params.append(filters[key])
    if filters.get("project"):
        where.append("(s.project like ? or s.cwd like ?)")
        params.extend((f"%{filters['project']}%", f"%{filters['project']}%"))
    if filters.get("since"):
        where.append("m.ts >= ?"); params.append(int(time.mktime(time.strptime(filters["since"], "%Y-%m-%d")) * 1000))
    sql = (f"select m.session_id, m.role, s.project, s.cli, m.ts, s.title, s.cwd, "
           f"snippet(messages_fts,0,'{HL_OPEN}','{HL_CLOSE}','…',{min(max(ctx * 5, 10), 64)}) "
           "from messages_fts f join messages m on m.rowid=f.rowid "
           "join sessions s on s.session_id=m.session_id "
           f"where {' and '.join(where)} order by f.rowid desc limit ?")
    # ספירה מלאה עולה 1.1ש על מונח נפוץ (worktree = 66,767). חוסמים ב-10,000
    # ומסמנים "+" — המספר המדויק אינו שווה שנייה בכל חיפוש.
    CAP_COUNT = 10000
    total = con.execute("select count(*) from (select 1 from messages_fts f "
                        "join messages m on m.rowid=f.rowid "
                        "join sessions s on s.session_id=m.session_id "
                        f"where {' and '.join(where)} limit {CAP_COUNT})", params).fetchone()[0]
    total_capped = total >= CAP_COUNT
    ok = word_filter(term, need_all=False) if whole_word else None
    hits, scanned = [], 0
    for cap in SCAN_STEPS:                       # הדרגתי: מונח נפוץ משלם רק מה שצריך
        rows = con.execute(sql, params + [cap]).fetchall()
        hits, scanned = [], len(rows)
        for sid, role, proj, cli, ts, title, cwd, snip in rows:
            txt = clean(snip or "")
            if ok and not ok(txt):
                continue
            hits.append({"session": sid, "short": short_sid(sid), "role": role, "project": proj, "cli": cli,
                         "title": title, "cwd": cwd,
                         "ts": ts, "text": " ".join(txt.split())})
            if len(hits) >= limit:
                break
        if len(hits) >= limit or scanned < cap:
            break
    return {"source": "sessions", "total": total, "capped": total_capped,
            "hits": hits, "scanned": scanned}


def short_sid(sid):
    """session_id הוא נתיב (--home-user--/2026-07-30T…_019fb35a…) או UUID. להציג מזהה קריא."""
    tail = sid.rsplit("/", 1)[-1]
    m = re.search(r"([0-9a-f]{8})(?:[-_][0-9a-f]{4}){0,3}", tail)
    return m.group(1) if m else tail[:12]


# ── comms: הודעות אישיות (comms-index) ──────────────────────────────────────

def comms_db():
    """נתיב ה-DB מהקונפיג של comms-index — הסכמה שייכת לו, ask קורא בלבד."""
    try:
        with open(CFG_COMMS, encoding="utf-8") as f:
            p = json.load(f).get("db_path")
        if p:
            return os.path.expanduser(p)
    except FileNotFoundError:
        pass
    except Exception as e:
        die(f"קונפיג comms-index פגום ({CFG_COMMS}): {e}")
    return DB_COMMS_DEFAULT


def comms_fts(term, parts):
    """trigram הוא התאמת תת-מחרוזת, ולכן כל חלק נשלח כרצף. תחביר בוליאני עובר כמו שהוא."""
    if re.search(r"\b(OR|NOT|NEAR)\b", term):
        return fts_query(term)
    return " ".join('"' + " ".join(w.strip("*") for w in p).replace('"', '""') + '"' for p in parts)


def search_comms(term, limit, ctx, filters, whole_word):
    db = comms_db()
    if not os.path.exists(db):
        return {"source": "comms", "total": 0, "hits": [],
                "error": f"אין אינדקס הודעות ב-{db} — להריץ comms-index update"}
    con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
    parts = term_parts(term)
    if not parts:
        die("מונח ריק")
    where, params = [], []
    if all(len(" ".join(p).replace("*", "")) >= 3 for p in parts):
        where.append("m.id in (select rowid from messages_fts where messages_fts match ?)")
        params.append(comms_fts(term, parts))
    else:
        # 🛑 trigram אינו מוצא מחרוזת קצרה משלושה תווים — אפס תוצאות, בלי שגיאה.
        # ההודעות קצרות, וסריקה ישירה של כולן מהירה מספיק.
        for p in parts:
            where.append("m.text like ?")
            params.append(f"%{' '.join(w.strip('*') for w in p)}%")
    if filters.get("channel"):
        chans = sorted({CHANNELS.get(c.strip().lower(), c.strip().lower())
                        for c in filters["channel"].split(",") if c.strip()})
        where.append(f"m.source in ({','.join('?' * len(chans))})")
        params += chans
    if filters.get("chat"):
        where.append("(m.conv_name like ? or m.sender like ?)")
        params += [f"%{filters['chat']}%"] * 2
    if filters.get("since"):
        where.append("m.ts >= ?")
        params.append(int(time.mktime(time.strptime(filters["since"], "%Y-%m-%d"))))
    cond = " and ".join(where)
    CAP_COUNT = 10000
    try:
        total = con.execute(f"select count(*) from (select 1 from messages m where {cond} limit {CAP_COUNT})",
                            params).fetchone()[0]
    except sqlite3.OperationalError as e:
        return {"source": "comms", "total": 0, "hits": [], "error": f"שאילתה לא תקינה: {e}"}
    ok = word_filter(term, need_all=True) if whole_word else None
    regs = [r for r in (part_re(p, whole_word) for p in parts) if r]
    sql = ("select m.ref, m.source, m.account, m.conv_name, m.sender, m.from_me, m.ts, m.text "
           f"from messages m where {cond} order by m.ts desc, m.id desc limit ?")
    hits, scanned = [], 0
    for cap in COMMS_SCAN_STEPS:
        rows = con.execute(sql, params + [cap]).fetchall()
        hits, scanned = [], len(rows)
        for ref, src, acct, conv, sender, from_me, ts, text in rows:
            if ok and not ok(text):
                continue
            hits.append({"ref": ref, "channel": src, "account": acct, "conv": conv, "sender": sender,
                         "from_me": bool(from_me), "ts": ts, "text": window(text, regs, ctx)})
            if len(hits) >= limit:
                break
        if len(hits) >= limit or scanned < cap:
            break
    return {"source": "comms", "total": total, "capped": total >= CAP_COUNT, "hits": hits, "scanned": scanned}


def comms_lags(db):
    """אזהרות התיישנות: ווטסאפ אמור להתעדכן כל כמה דקות, ארכיון ה-SMS כל רבע שעה."""
    try:
        con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
        rows = con.execute("select source, account, key, value from state").fetchall()
    except sqlite3.Error:
        return []
    st = {}
    for s, a, k, v in rows:
        st.setdefault((s, a), {})[k] = v
    now, out = time.time(), []

    def age(key, kv):
        try:
            v = float(kv.get(key) or 0)
        except ValueError:
            v = 0
        return (now - v) / 3600 if v else None

    for (s, a), kv in sorted(st.items()):
        upd = age("last_update", kv)
        if s == "wa" and (upd is None or upd > 1):
            out.append(f"wa/{a} " + ("לא עודכן אף פעם" if upd is None else f"לא עודכן {upd:.0f} שעות"))
        if s == "sms":
            pulled, ran = age("last_pull_ok", kv), age("phone_last_run", kv)
            if pulled is None or pulled > 24:
                out.append(f"sms/{a}: העותק מהטלפון " +
                           ("לא נמשך אף פעם" if pulled is None else f"בן {pulled:.0f} שעות"))
            elif ran is None or ran > 24:
                out.append(f"sms/{a}: הארכיון בטלפון " +
                           ("לא רץ אף פעם" if ran is None else f"לא רץ {ran:.0f} שעות"))
    return out


def show_msg(ref, around, jsonout):
    """ask msg <ref> — ההודעה וההודעות שסביבה באותה שיחה."""
    if not re.fullmatch(r"[0-9a-fA-F]{4,40}", ref):
        die(f"מזהה הודעה לא תקין: {ref!r}")
    db = comms_db()
    if not os.path.exists(db):
        die(f"אין אינדקס הודעות ב-{db}")
    con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
    rows = con.execute("select id, source, account, conv_id, conv_name, ts from messages where ref like ?",
                       (ref.lower() + "%",)).fetchall()
    if not rows:
        die(f"אין הודעה התואמת {ref!r}")
    if len(rows) > 1:
        print(f"{len(rows)} הודעות תואמות — להאריך את המזהה", file=sys.stderr)
        sys.exit(2)
    mid, src, acct, conv_id, conv, ts = rows[0]
    cols = "id, ref, sender, from_me, ts, text"
    same = "source=? and account=? and conv_id=?"
    before = con.execute(f"select {cols} from messages where {same} and (ts < ? or (ts = ? and id < ?)) "
                         "order by ts desc, id desc limit ?", (src, acct, conv_id, ts, ts, mid, around)).fetchall()
    target = con.execute(f"select {cols} from messages where id=?", (mid,)).fetchone()
    after = con.execute(f"select {cols} from messages where {same} and (ts > ? or (ts = ? and id > ?)) "
                        "order by ts, id limit ?", (src, acct, conv_id, ts, ts, mid, around)).fetchall()
    msgs = before[::-1] + [target] + after
    if jsonout:
        print(json.dumps({"conversation": {"channel": src, "account": acct, "id": conv_id, "name": conv},
                          "messages": [{"ref": r[1], "sender": r[2], "from_me": bool(r[3]), "ts": r[4],
                                        "text": r[5], "match": r[0] == mid} for r in msgs]}, ensure_ascii=False))
        return
    print(f"# {conv} · {src}/{acct}")
    print("─" * 60)
    for r in msgs:
        who = "אני" if r[3] else (r[2] or conv)
        lines = (r[5] or "").splitlines() or [""]
        print(f"{'▶' if r[0] == mid else ' '} {fmt_dt(r[4])}  {who}: {lines[0]}")
        for ln in lines[1:]:
            print(f"{' ' * 18}{ln}")


def index_lag(confdir):
    """האינדקס הוא cache. עריכת קובץ נקלטת מיד, אבל העברת תיקיות שוברת את
    המוניטור (-n) — נמדד: 152 נהלים שהועברו נעלמו מהחיפוש בלי שום שגיאה."""
    try:
        idx = max(os.path.getmtime(os.path.join(confdir, f))
                  for f in os.listdir(confdir) if f.startswith("xapiandb") or f == "xapiandb")
    except Exception:
        try:
            idx = os.path.getmtime(os.path.join(confdir, "xapiandb"))
        except Exception:
            return None
    hours = (time.time() - idx) / 3600
    return hours if hours > 24 else None


def show_session(sid_frag, jsonout):
    """ask session <id> — קריאת סשן מלא. מקבל גם קיצור (8 תווים מפלט החיפוש),
    מה ש-sq --session אינו עושה: הוא דורש את המזהה המלא."""
    db = sessions_db()
    if not os.path.exists(db):
        die(f"אין DB ב-{db}")
    con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
    selection = "select session_id, cli, project, cwd, started_at, title from sessions "
    rows = con.execute(selection + "where session_id = ?", (sid_frag,)).fetchall()
    if not rows:
        # Search-result short IDs belong to the filename, not to a shared parent
        # directory. A broad LIKE alone can match unrelated siblings.
        candidates = con.execute(selection + "where session_id like ?", (f"%{sid_frag}%",)).fetchall()
        rows = [row for row in candidates if sid_frag in row[0].rsplit("/", 1)[-1]]
    if not rows:
        die(f"אין סשן התואם {sid_frag!r}")
    # ה-DB מחזיק סשן גם לפי נתיב וגם לפי UUID — נמדד: 611 "התנגשויות" ב-8 תווים,
    # ורובן אותו סשן פעמיים. מאחדים לפי המזהה המחולץ ובוחרים את העשיר ביותר.
    if len(rows) > 1:
        by_id = {}
        for r in rows:
            by_id.setdefault(short_sid(r[0]), []).append(r)
        if len(by_id) == 1:
            rows = [max(next(iter(by_id.values())),
                        key=lambda r: con.execute(
                            "select count(*) from messages where session_id = ?", (r[0],)
                        ).fetchone()[0])]
    if len(rows) > 1:
        print(f"{len(rows)} סשנים תואמים — להרחיב את המזהה:", file=sys.stderr)
        for r in rows[:8]:
            ttl = " ".join((r[5] or "").split())[:52]
            print(f"  {short_sid(r[0])}  {r[2]} · {r[1]} · {ttl}", file=sys.stderr)
        sys.exit(2)
    sid, cli, proj, cwd, started, title = rows[0]
    msgs = con.execute("select role, model, ts, text from messages where session_id = ? order by seq",
                       (sid,)).fetchall()
    if jsonout:
        meta_cursor = con.execute("select * from sessions where session_id = ?", (sid,))
        metadata = dict(zip((column[0] for column in meta_cursor.description), meta_cursor.fetchone()))
        print(json.dumps({"session": {"id": sid, **metadata},
                          "messages": [{"role": r, "model": m, "ts": t, "text": x}
                                       for r, m, t, x in msgs]}, ensure_ascii=False))
        return
    print(f"# {' '.join((title or '(ללא כותרת)').split())}")
    print(f"{cli} · {proj} · {cwd or '?'} · {len(msgs)} הודעות")
    print("─" * 60)
    for role, model, ts, text in msgs:
        print(f"\n## {role}{f' ({model})' if model else ''} · {fmt_ts(ts)}")
        print(text)


def fmt_ts(ms):
    return time.strftime("%d/%m", time.localtime(ms / 1000)) if ms else "?"


def fmt_dt(sec):
    """בהודעות השנה חשובה — הארכיון מגיע שנים אחורה."""
    return time.strftime("%d/%m/%y %H:%M", time.localtime(sec)) if sec else "?"


def render(term, results, used, ctx, jsonout, warnings=()):
    if jsonout:
        print(json.dumps({"term": term, "sources": used, "context": ctx,
                          "results": results, "warnings": list(warnings)}, ensure_ascii=False))
        return
    counts = " · ".join(f"{r['source']} {r['total']:,}{'+' if r.get('capped') else ''}"
                        for r in results)
    marks = " · ".join(("🔒 " if s in PRIVATE else "") + s for s in used)
    print(f"{term} · {counts}    [מקורות: {marks} · ctx={ctx}]")
    for w in warnings:
        print(f"⚠️  {w}")
    for r in results:
        if r.get("error"):
            print(f"\n⚠️  {r['source']}: {r['error']}")
            continue
        if not r["hits"]:
            print(f"\n— {r['source']}: אין תוצאות" +
                  (f" (נסרקו {r['scanned']})" if r.get("scanned") else ""))
            continue
        print(f"\n── {r['source']} ──")
        for h in r["hits"]:
            if r["source"] == "comms":
                who = "אני" if h["from_me"] else h["sender"]
                head = " · ".join(x for x in (fmt_dt(h["ts"]), h["channel"], h["conv"],
                                              who if who != h["conv"] else "") if x)
                print(f"  {head}{' ' * 4}ask msg {h['ref']}")
                print(f"     {h['text'][:240]}")
            elif r["source"] == "sessions":
                print(f"  {fmt_ts(h['ts'])} · {h['project']} · {h['cli']}"
                      f"{' ' * 4}ask session {h['short']}")
                print(f"     {h['text'][:240]}")
            else:
                tags = "·".join(x for x in (h["space"], h["lifecycle"]) if x)
                dup = f"  (+{h['dupes']} ענפים)" if h.get("dupes") else ""
                print(f"  {h['path']}" + (f"   [{tags}]" if tags else "") + dup)
                for s in h["snippets"]:
                    ln = f"L{s['line']}" if s["line"] else "  "
                    print(f"     {ln:<6}{s['text'][:170]}")
                if not h["snippets"]:
                    print("     (אין הקשר — שאילתת שדה בלבד, בלי מונח תוכן)")


def main():
    # ‏`ask session <id>` כתת-פקודה; -- מאפשר מזהה מלא שמתחיל במקף.
    # 🛑 המרכאות של ה-shell אינן מבדילות: `ask "session" -n 1` מגיע כ-
    # ['ask','session','-n','1'] בדיוק כמו בלעדיהן. לכן ההבחנה היא על
    # הארגומנט השני: דגל ⇒ חיפוש. `ask -- session` נשאר למקרה הנדיר
    # שבו מחפשים את הצירוף "session <משהו>" כטקסט.
    if (len(sys.argv) > 2 and sys.argv[1] == "session"
            and (not sys.argv[2].startswith("-") or sys.argv[2] == "--"
                 or (sys.argv[2] == "--json" and "--" in sys.argv[3:]))):
        sp = argparse.ArgumentParser(prog="ask session", description="קריאת סשן מלא מהארכיון")
        sp.add_argument("id", help="מזהה סשן — מלא או קיצור מפלט החיפוש")
        sp.add_argument("--json", action="store_true")
        a = sp.parse_args(sys.argv[2:])
        return show_session(a.id, a.json)
    if len(sys.argv) > 2 and sys.argv[1] == "msg" and (not sys.argv[2].startswith("-") or sys.argv[2] == "--"):
        sp = argparse.ArgumentParser(prog="ask msg", description="🔒 הודעה מהאינדקס, עם ההודעות שסביבה בשיחה")
        sp.add_argument("ref", help="מזהה מפלט החיפוש (ask msg <ref>)")
        sp.add_argument("--around", type=int, default=8, metavar="N", help="הודעות לפני ואחרי (8)")
        sp.add_argument("--json", action="store_true")
        a = sp.parse_args(sys.argv[2:])
        return show_msg(a.ref, max(0, a.around), a.json)
    if len(sys.argv) > 1 and sys.argv[1] == "--":
        sys.argv.pop(1)

    p = argparse.ArgumentParser(
        prog="ask", add_help=True,
        description="חיפוש אחד בכל מאגרי הידע, עם בלוק הקשר סביב המילה.",
        epilog="ברירת מחדל: knowledge + sessions. ‏diary ו-comms רק במפורש (--diary, --comms).  "
               "תת-פקודות: ask session <id> — קריאת סשן מלא (מקבל גם קיצור) · "
               "ask msg <ref> — הודעה וההודעות שסביבה.  "
               "לחיפוש המילה session או msg עצמה: ask -- session")
    p.add_argument("term", help="מונח חיפוש. מרכאות כפולות = ביטוי מדויק.")
    p.add_argument("--knowledge", action="store_true", help="ויקי, נהלים וקוד (~/.recoll)")
    p.add_argument("--sessions", action="store_true", help="ארכיון שיחות הסוכנים")
    p.add_argument("--comms", action="store_true",
                   help="🔒 הודעות אישיות (ווטסאפ, SMS) — מפורש בלבד. מה שמודפס נכנס לארכיון השיחות")
    p.add_argument("--diary", action="store_true", help="🔒 יומן וכספת אישית — מפורש בלבד")
    p.add_argument("--src", metavar="A,B", help="בורר כללי: knowledge,sessions,comms,diary")
    p.add_argument("--channel", metavar="C", help="בהודעות: wa,sms")
    p.add_argument("--chat", metavar="X", help="בהודעות: חלק משם השיחה או השולח")
    p.add_argument("-n", "--limit", type=int, default=8, metavar="N", help="תוצאות לכל מקור (8)")
    p.add_argument("--context", type=int, default=12, metavar="W",
                   help="מילות הקשר סביב המילה (12). 4≈50 תווים · 30≈500. "
                        "בשיחות מתורגם לטוקני-trigram ונחסם ב-64 (מגבלת SQLite)")
    p.add_argument("--project", metavar="X"); p.add_argument("--cli", metavar="Y")
    p.add_argument("--role", metavar="R"); p.add_argument("--since", metavar="YYYY-MM-DD")
    p.add_argument("--no-word", action="store_true",
                   help="בלי סינון מילה-שלמה בשיחות (ה-FTS הוא trigram: rust⊂trust)")
    p.add_argument("--stem", action="store_true",
                   help="הרחבת גזירה (inotify→notify/notifier). כבוי — recoll הוא צורה מדויקת")
    p.add_argument("--json", action="store_true")
    args = p.parse_args()          # 🛑 argparse נכשל על דגל לא-מוכר — ולא בולע אותו בשקט

    used = [s for s, on in (("knowledge", args.knowledge), ("sessions", args.sessions),
                            ("comms", args.comms), ("diary", args.diary)) if on]
    if args.src:
        for s in (x.strip() for x in args.src.split(",") if x.strip()):
            if s not in SOURCES:
                die(f"מקור לא מוכר: {s!r} (אפשריים: {', '.join(SOURCES)})")
            if s not in used:
                used.append(s)
    if not used:
        used = ["knowledge", "sessions"]          # diary ו-comms לעולם לא כאן

    ctx = max(1, args.context)
    results = []
    for s in used:
        if s == "knowledge":
            results.append(search_recoll(CONF_KNOW, args.term, args.limit, ctx, "knowledge", args.stem))
        elif s == "diary":
            results.append(search_recoll(CONF_DIARY, args.term, args.limit, ctx, "diary", args.stem))
        elif s == "comms":
            results.append(search_comms(args.term, args.limit, ctx,
                                        {"channel": args.channel, "chat": args.chat, "since": args.since},
                                        not args.no_word))
        else:
            results.append(search_sessions(args.term, args.limit, ctx,
                                           {"project": args.project, "cli": args.cli,
                                            "role": args.role, "since": args.since},
                                           not args.no_word))
    warnings = []
    for s_name, conf in (("knowledge", CONF_KNOW), ("diary", CONF_DIARY)):
        if s_name in used:
            h = index_lag(conf)
            if h:
                warnings.append(f"אינדקס {s_name} לא עודכן {h:.0f} שעות — אחרי שינוי מבנה נדרש recollindex מלא")
    if "comms" in used:
        warnings += [f"comms: {w}" for w in comms_lags(comms_db())]
    render(args.term, results, used, ctx, args.json, warnings)


if __name__ == "__main__":
    main()
