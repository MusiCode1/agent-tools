#!/usr/bin/env python3
"""Manage reply-language-gate session exceptions."""

import argparse
import json
import os
import sys
import time

from gate import allow_path, read_allowed, update_allowed


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    allow = commands.add_parser("allow", help="allow a session to use another language")
    allow.add_argument("--reason", required=True, help="quote the user's language request")
    for command in (allow, commands.add_parser("revoke"), commands.add_parser("check")):
        command.add_argument("--session", help="defaults to CLAUDE_CODE_SESSION_ID")
    commands.add_parser("list")
    args = parser.parse_args()

    if args.command != "list":
        session_id = args.session if args.session is not None else os.environ.get("CLAUDE_CODE_SESSION_ID", "")
        if not session_id.strip():
            parser.error("set --session ID or CLAUDE_CODE_SESSION_ID")
    if args.command == "allow" and not args.reason.strip():
        parser.error("--reason must quote the user's request")

    try:
        if args.command == "allow":
            update_allowed(session_id, args.reason)
        elif args.command == "revoke":
            update_allowed(session_id, None)
        else:
            records = read_allowed(allow_path(), time.time())
            if args.command == "check":
                return 0 if session_id in records else 1
            for record in records.values():
                print(json.dumps(record, ensure_ascii=False))
    except (OSError, ValueError, TypeError, KeyError) as error:
        print(f"reply-language-gate: {error}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
