# חיבור קבוע ל-Google Messages דרך gmcli: מקבל הודעות בזמן אמת ושומר על הצימוד
# (Google מנתקת צימוד אחרי כ-14 ימים בלי פעילות). comms-index קורא את ה-DB שלו.
# קוד יציאה 3 = התנתקות מחשבון Google ⇒ לא מנסים שוב; צריך `gmcli auth` מחדש.
[Unit]
Description=gmcli sync --follow (Google Messages archive for comms-index)
Documentation=https://github.com/MusiCode1/agent-tools/tree/main/comms-index
After=network-online.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/gmcli --read-only sync --follow
Restart=on-failure
RestartSec=60
RestartPreventExitStatus=3
Nice=10

[Install]
WantedBy=default.target
