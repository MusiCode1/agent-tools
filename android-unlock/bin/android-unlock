#!/usr/bin/env python3
"""android-unlock — הזנת תבנית / PIN / סיסמה למכשיר אנדרואיד מרוחק.

הקרדנציאל נשלף מביטוורדן (פריט לכל מכשיר), לעולם לא מודפס ולא נכתב לקובץ,
ו-logcat מנוקה אחרי כל שלב שהעמיד אותו בשורת-פקודה על המכשיר.

מסלול התבנית עובר דרך עץ-הנגישות (uiautomator dump → גבולות רשת-התבנית →
9 נקודות → input motionevent), ולכן עובד גם תחת FLAG_SECURE (שחוסם לכידת-
פיקסלים אך לא את עץ ה-AccessibilityNodeInfo) וגם בלי root. PIN/סיסמה נכנסים
דרך `input text`. root נדרש רק ל-verify המקדים ול--remove-lock.
"""
from __future__ import annotations
import argparse, json, os, re, subprocess, sys, time
from pathlib import Path

HERE = Path(__file__).resolve().parent
REGISTRY = HERE.parent / "devices.json"

CRED_FIELDS = {
    "pattern":  "screen-lock-pattern",
    "pin":      "screen-lock-pin",
    "password": "screen-lock-password",
}
# node של רשת-התבנית משתנה בין יצרנים — מתאימים לפי סיומת ה-id, לא לפי שם קשיח
PATTERN_IDS = ("lockPatternView", "colorLockPatternView",
               "oplusos_kgd_security_pattern_view")


def log(msg): print(msg, file=sys.stderr, flush=True)


def die(msg, code=1):
    log(f"✗ {msg}")
    sys.exit(code)


# ---------- ביטוורדן ----------
def bw_unlocked() -> bool:
    try:
        out = subprocess.run(["bw-mcp-cli", "status"], capture_output=True,
                             text=True, timeout=25).stdout
        return json.loads(out).get("status") == "unlocked"
    except Exception:
        return False


def bw_item(name: str) -> dict:
    out = subprocess.run(["bw-mcp-cli", "get", "item", name],
                         capture_output=True, text=True, timeout=25)
    if out.returncode != 0 or not out.stdout.strip():
        die(f"פריט ביטוורדן '{name}' לא נמצא ({out.stderr.strip()[:120]})")
    return json.loads(out.stdout)


def cred_from_item(item: dict, ctype: str | None):
    fields = {f["name"]: f.get("value") for f in item.get("fields", [])}
    if ctype:  # סוג מפורש
        v = fields.get(CRED_FIELDS[ctype])
        if not v:
            die(f"לפריט אין שדה '{CRED_FIELDS[ctype]}'")
        return ctype, v
    for t, fname in CRED_FIELDS.items():  # זיהוי אוטומטי לפי סדר-עדיפות
        if fields.get(fname):
            return t, fields[fname]
    die("לא נמצא אף שדה-נעילה (screen-lock-pattern/-pin/-password) בפריט")


# ---------- הרצה על המכשיר ----------
class Device:
    def __init__(self, ssh: str, via: str):
        self.ssh = ssh
        self.via = via            # root | rish | none
        self._wrap = None
        self._root = None

    def _ssh(self, remote_cmd: str, stdin: str | None = None, timeout=60):
        cmd = ["ssh", "-o", "ConnectTimeout=12", self.ssh, remote_cmd]
        return subprocess.run(cmd, input=stdin, capture_output=True,
                             text=True, timeout=timeout)

    def detect(self):
        """קובע עטיפת-הרצה (wrap) וזמינות-root."""
        r = self._ssh("su -c id 2>/dev/null").stdout
        self._root = "uid=0" in r
        if self.via == "root":
            if not self._root:
                die(f"{self.ssh}: ביקשת via=root אך אין גישת root")
            self._wrap = "su -c"
        elif self.via == "rish":
            self._wrap = "$HOME/rish -c"
        elif self.via == "none":
            self._wrap = ""
        else:  # auto
            if self._root:
                self._wrap = "su -c"
            elif "yes" in self._ssh("test -x $HOME/rish && echo yes").stdout:
                self._wrap = "$HOME/rish -c"
            else:
                self._wrap = ""

    @property
    def root(self) -> bool:
        return bool(self._root)

    def sh(self, script: str, as_root=False, timeout=60) -> str:
        """מריץ סקריפט shell על המכשיר (stdin), בעטיפה שנקבעה."""
        wrap = "su -c" if as_root else self._wrap
        remote = f"{wrap} sh" if wrap else "sh"
        res = self._ssh(remote, stdin=script, timeout=timeout)
        return (res.stdout or "") + (res.stderr or "")

    def clean_logcat(self):
        try:
            self.sh("logcat -c\n", as_root=self.root, timeout=20)
        except Exception:
            pass


# ---------- recon ----------
def recon(dev: Device) -> dict:
    out = dev.sh(
        "echo KG=$(dumpsys window 2>/dev/null | grep -m1 -o 'isKeyguardShowing=[a-z]*')\n"
        "echo CALL=$(dumpsys telephony.registry 2>/dev/null | grep -m1 -o 'mCallState=[0-9]*')\n"
        "echo SIZE=$(wm size 2>/dev/null | grep -m1 -o '[0-9]*x[0-9]*' | head -1)\n"
        "echo TOP=$(dumpsys activity activities 2>/dev/null | grep -m1 -o 'topResumedActivity=[^ ]*')\n")
    d = {}
    for line in out.splitlines():
        if "=" in line:
            k, _, v = line.partition("=")
            d[k.strip()] = v.strip()
    return {
        "keyguard": d.get("KG", "").endswith("true"),
        "call": d.get("CALL", "mCallState=0").split("=")[-1] not in ("", "0"),
        "size": d.get("SIZE", ""),
        "top": d.get("TOP", ""),
    }


# ---------- תבנית ----------
def grid_bounds(xml: str):
    for node in re.finditer(r'<node[^>]*>', xml):
        s = node.group(0)
        rid = re.search(r'resource-id="([^"]*)"', s)
        rid = rid.group(1) if rid else ""
        desc = re.search(r'content-desc="([^"]*)"', s)
        desc = desc.group(1) if desc else ""
        hit = any(rid.endswith(p) for p in PATTERN_IDS) \
            or ("pattern" in desc.lower()) or ("תבנית" in desc)
        if hit:
            b = re.search(r'bounds="\[(\d+),(\d+)\]\[(\d+),(\d+)\]"', s)
            if b:
                return tuple(int(x) for x in b.groups())
    return None


def pattern_points(bounds):
    L, T, R, B = bounds
    w, h = (R - L) / 3.0, (B - T) / 3.0
    def xy(d):
        i = d - 1
        return (int(L + (i % 3 + 0.5) * w), int(T + (i // 3 + 0.5) * h))
    return {d: xy(d) for d in range(1, 10)}


def raise_bouncer_script():
    return ("input keyevent KEYCODE_WAKEUP\nsleep 0.5\n"
            "input swipe 600 1600 600 500 150\nsleep 0.9\n")


def inject_pattern(dev: Device, digits: str, dry=False) -> bool:
    dev.sh(raise_bouncer_script())
    xml = dev.sh("uiautomator dump /sdcard/.au.xml >/dev/null 2>&1; cat /sdcard/.au.xml; rm -f /sdcard/.au.xml\n")
    b = grid_bounds(xml)
    if not b:
        die("לא נמצאה רשת-תבנית בעץ-הנגישות (האם ה-bouncer עלה? אולי הנעילה אינה תבנית)")
    pts = pattern_points(b)
    seq = [int(c) for c in digits if c in "123456789"]
    if len(seq) < 4:
        die("תבנית קצרה מ-4 נקודות — כנראה ערך שגוי בביטוורדן")
    log(f"  רשת: bounds={b}  נקודות-תבנית={len(seq)}")
    if dry:
        return False
    lines = []
    for k, d in enumerate(seq):
        x, y = pts[d]
        lines.append(f"input motionevent {'DOWN' if k == 0 else 'MOVE'} {x} {y}")
        lines.append("sleep 0.08")
    lx, ly = pts[seq[-1]]
    lines.append(f"input motionevent UP {lx} {ly}")
    dev.sh("\n".join(lines) + "\n")
    time.sleep(1.0)
    return True


# ---------- PIN / סיסמה ----------
def inject_text(dev: Device, text: str, dry=False) -> bool:
    dev.sh(raise_bouncer_script())
    if dry:
        log("  (dry-run: לא הוזן טקסט)")
        return False
    esc = text.replace(" ", "%s")  # input text מצריך %s לרווח
    dev.sh(f"input text '{esc}'\nsleep 0.3\ninput keyevent KEYCODE_ENTER\n")
    time.sleep(1.0)
    return True


# ---------- root: verify / clear ----------
def verify_credential(dev: Device, cred: str) -> bool:
    out = dev.sh(f"locksettings verify --old '{cred}'\n", as_root=True)
    dev.clean_logcat()
    return "verified successfully" in out


def remove_lock(dev: Device, cred: str) -> bool:
    out = dev.sh(f"locksettings clear --old '{cred}'\n", as_root=True)
    dev.clean_logcat()
    chk = dev.sh("locksettings get-disabled 2>/dev/null; "
                 "dumpsys lock_settings 2>/dev/null | grep -m1 CredentialType\n", as_root=True)
    return "NONE" in chk or "verified" in out.lower() or "success" in out.lower()


# ---------- רישום מכשירים ----------
def load_registry():
    if REGISTRY.exists():
        return json.loads(REGISTRY.read_text(encoding="utf-8"))
    return {}


def resolve_device(name, args):
    reg = load_registry()
    prof = reg.get(name, {})
    ssh = args.ssh or prof.get("ssh", name)
    via = args.via or prof.get("via", "auto")
    bw = args.bw_item or prof.get("bw_item", name)
    return ssh, via, bw


# ---------- main ----------
def main():
    p = argparse.ArgumentParser(
        prog="android-unlock",
        description="הזנת תבנית/PIN/סיסמה למכשיר אנדרואיד מרוחק (קרדנציאל מביטוורדן).")
    p.add_argument("device", help="שם מכשיר (alias ב-ssh config + פריט ביטוורדן)")
    p.add_argument("--type", choices=list(CRED_FIELDS), help="סוג הקרדנציאל (ברירת-מחדל: זיהוי אוטומטי)")
    p.add_argument("--ssh", help="ssh alias (עוקף את הרישום)")
    p.add_argument("--via", choices=["auto", "root", "rish", "none"], help="עטיפת-הרצה על המכשיר")
    p.add_argument("--bw-item", dest="bw_item", help="שם פריט ביטוורדן (ברירת-מחדל: שם המכשיר)")
    p.add_argument("--no-verify", action="store_true", help="דילוג על אימות-root מקדים")
    p.add_argument("--remove-lock", action="store_true", help="🛑 הסרת הנעילה לגמרי (דורש root)")
    p.add_argument("--force", action="store_true", help="להזריק גם אם יש שיחה פעילה")
    p.add_argument("--dry-run", action="store_true", help="recon בלבד — בלי הזרקה")
    args = p.parse_args()

    if not bw_unlocked():
        die("כספת ביטוורדן נעולה. הרץ בטרמינל שלך: bw-mcp-unlock  (כלל 120), ואז שוב.")

    ssh, via, bw_name = resolve_device(args.device, args)
    item = bw_item(bw_name)
    ctype, cred = cred_from_item(item, args.type)
    log(f"מכשיר: {args.device}  ·  ssh={ssh}  ·  via={via}  ·  סוג={ctype}")

    dev = Device(ssh, via)
    dev.detect()
    log(f"  root={'כן' if dev.root else 'לא'}  wrap={dev._wrap or 'ללא'}")

    st = recon(dev)
    log(f"  keyguard={'מוצג' if st['keyguard'] else 'מבוטל'}  "
        f"call={'פעילה' if st['call'] else 'אין'}  size={st['size']}  top={st['top']}")

    if st["call"] and not args.force:
        die("שיחה פעילה על המכשיר — לא מזריק קלט עיוור. סיים שיחה או הרץ עם --force.")

    if not st["keyguard"] and not args.remove_lock:
        log("✓ המכשיר כבר פתוח (keyguard מבוטל). אין מה לעשות.")
        return

    # אימות-root מקדים — מונע ניסיונות-שווא לעבר נעילת-ה-5
    if dev.root and not args.no_verify:
        if verify_credential(dev, cred):
            log("  ✓ הקרדנציאל השמור אומת מול locksettings")
        else:
            die("הקרדנציאל בביטוורדן לא עבר verify על המכשיר — עצירה לפני הזרקה (סכנת נעילת-השהיה).")

    if args.remove_lock:
        if not dev.root:
            die("--remove-lock דורש root ואין גישת root על המכשיר הזה.")

    # הזרקה
    if st["keyguard"]:
        injected = inject_pattern(dev, cred, args.dry_run) if ctype == "pattern" \
            else inject_text(dev, cred, args.dry_run)
        dev.clean_logcat()
        if args.dry_run:
            log("✓ dry-run הושלם (לא הוזרק דבר).")
            return
        st2 = recon(dev)
        if st2["keyguard"]:
            die("ההזרקה לא ביטלה את ה-keyguard (עדיין מוצג). בדוק את סוג-הנעילה ואת הערך.")
        log(f"✓ נפתח — keyguard מבוטל, top={st2['top']}")

    if args.remove_lock:
        if remove_lock(dev, cred):
            log("✓ הנעילה הוסרה (locksettings clear). למכשיר אין יותר קרדנציאל-נעילה.")
        else:
            die("ניסיון remove-lock לא אומת כהצלחה — בדוק ידנית.")


if __name__ == "__main__":
    main()
